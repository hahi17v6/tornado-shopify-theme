<section class="tornado-section tornado-drop-banner container">
  <div class="glass-panel tornado-drop-banner__box">
    <span class="badge-tornado badge-drop mb-sm">NEXT DROP EXCLUSIF</span>
    <h2 class="display-subtitle text-gold-gradient mb-md">{{ section.settings.drop_title }}</h2>
    <p class="text-secondary mb-lg">{{ section.settings.drop_description }}</p>

    <div class="drop-countdown" data-drop-date="{{ section.settings.drop_date }}">
      <div class="drop-countdown__unit">
        <span class="drop-countdown__val" id="timer-days">03</span>
        <span class="drop-countdown__lbl">JOURS</span>
      </div>
      <div class="drop-countdown__unit">
        <span class="drop-countdown__val" id="timer-hours">14</span>
        <span class="drop-countdown__lbl">HEURES</span>
      </div>
      <div class="drop-countdown__unit">
        <span class="drop-countdown__val" id="timer-minutes">28</span>
        <span class="drop-countdown__lbl">MINUTES</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compte à Rebours Drop",
  "settings": [
    {
      "type": "text",
      "id": "drop_title",
      "label": "Titre du Drop",
      "default": "DROP VOL. 02 — THE OBSIDIAN COLLECTION"
    },
    {
      "type": "textarea",
      "id": "drop_description",
      "label": "Description",
      "default": "Série limitée à 300 exemplaires dans le monde. Inscrivez-vous pour obtenir votre accès anticipé VIP."
    },
    {
      "type": "text",
      "id": "drop_date",
      "label": "Date ISO (YYYY-MM-DD)",
      "default": "2026-11-01"
    }
  ],
  "presets": [
    {
      "name": "Compte à Rebours Drop TORNADO"
    }
  ]
}
{% endschema %}
