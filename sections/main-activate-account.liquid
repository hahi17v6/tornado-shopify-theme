{%- comment -%}
  TORNADO — ACTIVATE ACCOUNT (PHASE 7)
  Section d'activation de compte client OS 2.0
{%- endcomment -%}

<div class="tornado-customer-auth container padding-v-2xl">
  <div class="auth-card tornado-glass-card max-w-md margin-auto padding-xl text-center">
    <h1 class="auth-title font-heading text-2xl uppercase tracking-widest text-white margin-bottom-xs">
      ACTIVER MON COMPTE
    </h1>
    <p class="text-xs text-secondary margin-bottom-lg">
      Créez votre mot de passe pour activer votre espace membre VIP.
    </p>

    {%- form 'activate_customer_password', class: 'auth-form' -%}
      {%- if form.errors -%}
        <div class="auth-error tornado-badge tornado-badge--danger margin-bottom-md w-full text-center">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="form-group margin-bottom-md">
        <input type="password" name="customer[password]" id="ActivatePassword" placeholder="Mot de passe *" required class="tornado-input w-full">
      </div>

      <div class="form-group margin-bottom-md">
        <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" placeholder="Confirmer le mot de passe *" required class="tornado-input w-full">
      </div>

      <button type="submit" class="tornado-btn tornado-btn--gold text-sm font-bold uppercase tracking-wider w-full padding-v-md margin-bottom-md">
        ACTIVER LE COMPTE
      </button>

      <button type="submit" name="decline" class="tornado-btn tornado-btn--outline text-xs font-bold uppercase w-full">
        DÉCLINER L'INVITATION
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Activation Compte Client",
  "settings": []
}
{% endschema %}
