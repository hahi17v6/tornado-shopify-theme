<section class="tornado-section tornado-brands-section container">
  <div class="tornado-section__header text-center mb-lg">
    <span class="badge-tornado badge-limited mb-xs">SELECTION CURATÉE</span>
    <h2 class="display-subtitle text-gold-gradient">{{ section.settings.title }}</h2>
  </div>

  <div class="tornado-brands-grid">
    <div class="tornado-brand-card">
      <span class="tornado-brand-card__name">TORNADO LABS</span>
    </div>
    <div class="tornado-brand-card">
      <span class="tornado-brand-card__name">VALENTINO STUDIO</span>
    </div>
    <div class="tornado-brand-card">
      <span class="tornado-brand-card__name">OBSIDIAN PARIS</span>
    </div>
    <div class="tornado-brand-card">
      <span class="tornado-brand-card__name">ATELIER GOLD</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Showcase Marques",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre Section",
      "default": "NOS MARQUES ET MAISONS PARTENAIRES"
    }
  ],
  "presets": [
    {
      "name": "Showcase Marques TORNADO"
    }
  ]
}
{% endschema %}
