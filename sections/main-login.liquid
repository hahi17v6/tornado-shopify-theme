{%- comment -%}
  TORNADO — LOGIN PAGE (PHASE 7)
  Section de connexion client native Shopify OS 2.0
{%- endcomment -%}

<div class="tornado-customer-auth container padding-v-2xl">
  <div class="auth-card tornado-glass-card max-w-md margin-auto padding-xl text-center">
    <!-- Login Form Header -->
    <div id="login-header">
      <h1 class="auth-title font-heading text-2xl uppercase tracking-widest text-white margin-bottom-xs">
        CONNEXION
      </h1>
      <p class="text-xs text-secondary margin-bottom-lg">
        Accédez à votre espace VIP TORNADO, vos commandes et votre wishlist.
      </p>
    </div>

    <!-- Recover Password Header (Hidden by default) -->
    <div id="recover-header" style="display: none;">
      <h1 class="auth-title font-heading text-2xl uppercase tracking-widest text-white margin-bottom-xs">
        RÉINITIALISATION
      </h1>
      <p class="text-xs text-secondary margin-bottom-lg">
        Saisissez votre email pour recevoir les instructions de réinitialisation.
      </p>
    </div>

    <!-- Shopify Customer Login Form -->
    <div id="CustomerLoginForm">
      {%- form 'customer_login', class: 'auth-form' -%}
        {%- if form.errors -%}
          <div class="auth-error tornado-badge tornado-badge--danger margin-bottom-md w-full text-center">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-group margin-bottom-md">
          <label for="CustomerEmail" class="visually-hidden">Adresse Email</label>
          <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" placeholder="Adresse Email *" required class="tornado-input w-full">
        </div>

        {%- if form.password_needed -%}
          <div class="form-group margin-bottom-sm">
            <label for="CustomerPassword" class="visually-hidden">Mot de passe</label>
            <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" placeholder="Mot de passe *" required class="tornado-input w-full">
          </div>

          <div class="text-right margin-bottom-md">
            <a href="#recover" id="RecoverPasswordBtn" class="text-xs text-gold hover-gold font-bold">
              Mot de passe oublié ?
            </a>
          </div>
        {%- endif -%}

        <button type="submit" class="tornado-btn tornado-btn--gold text-sm font-bold uppercase tracking-wider w-full padding-v-md margin-bottom-md">
          SE CONNECTER
        </button>

        <div class="auth-switch text-xs text-secondary">
          Pas encore de compte ?
          <a href="{{ routes.account_register_url }}" class="text-gold font-bold uppercase hover-gold">
            CRÉER UN COMPTE
          </a>
        </div>
      {%- endform -%}
    </div>

    <!-- Password Recover Form (Hidden by default) -->
    <div id="RecoverPasswordForm" style="display: none;">
      {%- form 'recover_customer_password', class: 'auth-form' -%}
        {%- if form.errors -%}
          <div class="auth-error tornado-badge tornado-badge--danger margin-bottom-md w-full text-center">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="auth-success tornado-badge tornado-badge--success margin-bottom-md w-full text-center">
            Un email de réinitialisation vous a été envoyé.
          </div>
        {%- endif -%}

        <div class="form-group margin-bottom-md">
          <label for="RecoverEmail" class="visually-hidden">Adresse Email</label>
          <input type="email" name="email" id="RecoverEmail" autocomplete="email" placeholder="Adresse Email *" required class="tornado-input w-full">
        </div>

        <button type="submit" class="tornado-btn tornado-btn--gold text-sm font-bold uppercase tracking-wider w-full padding-v-md margin-bottom-md">
          ENVOYER LES INSTRUCTIONS
        </button>

        <div class="text-center">
          <a href="#login" id="CancelRecoverBtn" class="text-xs text-secondary hover-gold font-bold">
            &larr; Annuler et revenir à la connexion
          </a>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const recoverBtn = document.getElementById('RecoverPasswordBtn');
    const cancelBtn = document.getElementById('CancelRecoverBtn');
    const loginHeader = document.getElementById('login-header');
    const recoverHeader = document.getElementById('recover-header');
    const loginForm = document.getElementById('CustomerLoginForm');
    const recoverForm = document.getElementById('RecoverPasswordForm');

    if (recoverBtn && cancelBtn) {
      recoverBtn.addEventListener('click', (e) => {
        e.preventDefault();
        loginHeader.style.display = 'none';
        loginForm.style.display = 'none';
        recoverHeader.style.display = 'block';
        recoverForm.style.display = 'block';
      });

      cancelBtn.addEventListener('click', (e) => {
        e.preventDefault();
        recoverHeader.style.display = 'none';
        recoverForm.style.display = 'none';
        loginHeader.style.display = 'block';
        loginForm.style.display = 'block';
      });
    }

    if (window.location.hash === '#recover') {
      if (recoverBtn) recoverBtn.click();
    }
  });
</script>

{% schema %}
{
  "name": "Connexion Client",
  "settings": []
}
{% endschema %}
