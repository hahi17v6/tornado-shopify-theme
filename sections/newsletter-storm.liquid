{%- comment -%}
  TORNADO — NEWSLETTER STORM SECTION (PHASE 8)
  Section de capture d'emails premium avec offre de bienvenue -10%
{%- endcomment -%}

<div class="tornado-newsletter-section tornado-section container padding-v-2xl text-center" id="newsletter-storm">
  <div class="tornado-glass-card max-w-xl margin-auto padding-2xl relative overflow-hidden">
    <div class="newsletter-glow-bg"></div>

    <span class="tornado-badge tornado-badge--gold margin-bottom-xs">OFFRE EXCLUSIVE DE BIENVENUE</span>
    <h2 class="font-heading text-3xl uppercase tracking-widest text-white margin-bottom-xs">
      JOIN THE STORM
    </h2>
    <p class="text-sm text-secondary margin-bottom-lg max-w-md margin-auto">
      Obtenez <strong>-10% sur votre première commande</strong> et bénéficiez d'un accès anticipé (Early Access) à nos Drops en édition limitée.
    </p>

    {%- form 'customer', class: 'newsletter-form max-w-md margin-auto', id: 'NewsletterFormSection' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,welcome_discount">
      
      {%- if form.posted_successfully? -%}
        <div class="tornado-badge tornado-badge--success padding-md text-sm w-full margin-bottom-md">
          ✨ Bienvenue dans la Storm ! Votre code promo <strong>STORM10</strong> (-10%) vous a été envoyé par email.
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="tornado-badge tornado-badge--danger margin-bottom-md w-full">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-group flex gap-xs margin-bottom-md flex-mobile-column">
          <input type="email" name="contact[email]" placeholder="Votre adresse email *" required class="tornado-input flex-1">
          <button type="submit" class="tornado-btn tornado-btn--gold text-xs font-bold uppercase tracking-wider padding-v-md padding-h-lg">
            REJOINDRE &rarr;
          </button>
        </div>

        <div class="flex items-center justify-center gap-xs text-xs text-secondary">
          <input type="checkbox" name="customer[accepts_marketing]" id="NewsletterConsent" required class="tornado-checkbox">
          <label for="NewsletterConsent" class="cursor-pointer">
            J'accepte de recevoir les communications et offres exclusives TORNADO.
          </label>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter Join the Storm",
  "settings": []
}
{% endschema %}
