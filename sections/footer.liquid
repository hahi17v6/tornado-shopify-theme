<footer class="tornado-footer" data-section-id="{{ section.id }}">
  <div class="container tornado-footer__inner">
    <!-- Top Footer Row: Brand Info & Columns -->
    <div class="tornado-footer__grid">
      <!-- Column 1: Brand & Identity -->
      <div class="tornado-footer__col tornado-footer__col--brand">
        <div class="tornado-footer__logo">
          <span class="tornado-header__vortex">{% render 'icon-vortex' %}</span>
          <span class="tornado-header__wordmark">TORNADO</span>
        </div>
        <p class="tornado-footer__tagline text-secondary text-xs margin-top-xs">
          Maison de Haute Couture & Streetwear d'Exception. Éditions limitées, pièces numérotées et drops exclusifs.
        </p>
        <div class="tornado-footer__socials margin-top-md">
          <a href="#" class="tornado-footer__social-link" aria-label="Instagram">Instagram</a>
          <a href="#" class="tornado-footer__social-link" aria-label="TikTok">TikTok</a>
          <a href="#" class="tornado-footer__social-link" aria-label="YouTube">YouTube</a>
        </div>
      </div>

      <!-- Column 2: Navigation Links -->
      <div class="tornado-footer__col">
        <h4 class="tornado-footer__title font-heading text-xs uppercase tracking-widest text-gold">EXPLORER</h4>
        <ul class="tornado-footer__list">
          <li><a href="/collections/all">Toutes les Pièces</a></li>
          <li><a href="/collections/sweats">Sweats & Hoodies</a></li>
          <li><a href="/collections/vestes">Vestes & Manteaux</a></li>
          <li><a href="/collections/sneakers">Sneakers Luxe</a></li>
          <li><a href="/collections/new-drops" class="text-gold">Nouveaux Drops</a></li>
        </ul>
      </div>

      <!-- Column 3: Customer Care & Legal -->
      <div class="tornado-footer__col">
        <h4 class="tornado-footer__title font-heading text-xs uppercase tracking-widest text-gold">INFORMATIONS</h4>
        <ul class="tornado-footer__list">
          <li><a href="/pages/livraison">Livraison & Suivi</a></li>
          <li><a href="/pages/retours">Retours & Échanges</a></li>
          <li><a href="/pages/faq">Foire aux Questions</a></li>
          <li><a href="/pages/cgv">Conditions Générales (CGV)</a></li>
          <li><a href="/pages/confidentialite">Politique de Confidentialité</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div class="tornado-footer__col tornado-footer__col--newsletter">
        <h4 class="tornado-footer__title font-heading text-xs uppercase tracking-widest text-gold">JOIN THE STORM</h4>
        <p class="text-xs text-secondary margin-bottom-sm">
          Abonnez-vous pour recevoir les accès anticipés aux prochains Drops exclusifs et -10% sur votre première commande.
        </p>
        {% form 'customer', class: 'tornado-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="tornado-footer__form-group">
            <input type="email" name="contact[email]" placeholder="Votre adresse email..." required class="tornado-footer__input">
            <button type="submit" class="tornado-btn tornado-btn--gold text-xs font-bold uppercase">REJOINDRE</button>
          </div>
        {% endform %}
      </div>
    </div>

    <!-- Bottom Footer Row: Copyright & Country Selector -->
    <div class="tornado-footer__bottom">
      <div class="tornado-footer__copyright text-xs text-secondary">
        &copy; {{ 'now' | date: '%Y' }} TORNADO PARIS &bull; Tous droits réservés.
      </div>

      <!-- Localization Form (Shopify Markets) -->
      {% form 'localization', class: 'tornado-footer__localization' %}
        <div class="localization-selector">
          <select name="country_code" class="tornado-footer__select" onchange="this.form.submit()">
            {% for country in localization.available_countries %}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {% endfor %}
          </select>
        </div>
      {% endform %}

      <div class="tornado-footer__payments text-xs text-secondary">
        🔒 Paiement SSL 100% Sécurisé &bull; Visa &bull; Mastercard &bull; Apple Pay &bull; Paypal
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer TORNADO",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_socials",
      "label": "Afficher les réseaux sociaux",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Footer TORNADO"
    }
  ]
}
{% endschema %}
