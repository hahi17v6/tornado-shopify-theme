<header class="tornado-header" data-section-id="{{ section.id }}" data-header-sticky="{{ section.settings.enable_sticky }}">
  {% if section.settings.show_announcement %}
    <div class="tornado-header__announcement">
      <div class="container tornado-header__announcement-inner">
        <p>{{ section.settings.announcement_text }}</p>
      </div>
    </div>
  {% endif %}

  <div class="tornado-header__main container">
    <!-- Mobile Menu Toggle Button -->
    <button class="tornado-header__mobile-toggle" data-mobile-menu-toggle aria-label="Ouvrir le menu navigation" aria-expanded="false">
      {% render 'icon-menu' %}
    </button>

    <!-- Brand Logo -->
    <div class="tornado-header__brand">
      <a href="{{ routes.root_url }}" class="tornado-header__logo-link">
        <span class="tornado-header__vortex">{% render 'icon-vortex' %}</span>
        <span class="tornado-header__wordmark">TORNADO</span>
      </a>
    </div>

    <!-- Desktop Multi-Tier Navigation -->
    <nav class="tornado-header__nav desktop-only" role="navigation">
      <ul class="tornado-header__menu">
        <!-- SHOP Dropdown -->
        <li class="tornado-header__menu-item tornado-header__menu-item--has-dropdown">
          <a href="/collections/all" class="tornado-header__menu-link">SHOP ▾</a>
          <div class="tornado-megamenu">
            <div class="container tornado-megamenu__grid">
              <div class="tornado-megamenu__col">
                <span class="tornado-megamenu__title">VÊTEMENTS</span>
                <ul>
                  <li><a href="/collections/sweats">Sweats & Hoodies</a></li>
                  <li><a href="/collections/vestes">Vestes & Manteaux</a></li>
                  <li><a href="/collections/pantalons">Pantalons & Cargos</a></li>
                  <li><a href="/collections/t-shirts">T-shirts Heavyweight</a></li>
                </ul>
              </div>
              <div class="tornado-megamenu__col">
                <span class="tornado-megamenu__title">CHAUSSURES & ACCESSOIRES</span>
                <ul>
                  <li><a href="/collections/sneakers">Sneakers Luxe</a></li>
                  <li><a href="/collections/casquettes">Casquettes & Bonnets</a></li>
                  <li><a href="/collections/sacs">Sacs & Sacoches</a></li>
                  <li><a href="/collections/bijoux">Bijoux & Chaînes</a></li>
                </ul>
              </div>
              <div class="tornado-megamenu__col tornado-megamenu__col--featured">
                <div class="tornado-megamenu__promo">
                  <span class="badge-tornado badge-drop">DROP VOL. 01</span>
                  <h4>THE OBSIDIAN HOODIE</h4>
                  <a href="/collections/all" class="text-gold-gradient font-bold">DÉCOUVRIR &rarr;</a>
                </div>
              </div>
            </div>
          </div>
        </li>

        <!-- DISCOVER Dropdown -->
        <li class="tornado-header__menu-item tornado-header__menu-item--has-dropdown">
          <a href="/collections/new-drops" class="tornado-header__menu-link">DISCOVER ▾</a>
          <ul class="tornado-dropdown">
            <li><a href="/collections/new-drops">Nouveautés (New Drops)</a></li>
            <li><a href="/collections/best-sellers">Best-Sellers</a></li>
            <li><a href="/collections/editions-limitees">Éditions Limitées</a></li>
            <li><a href="/collections/promotions">Ventes Flash / Archives</a></li>
          </ul>
        </li>

        <!-- BRANDS Dropdown -->
        <li class="tornado-header__menu-item">
          <a href="/pages/marques" class="tornado-header__menu-link">MARQUES</a>
        </li>
      </ul>
    </nav>

    <!-- Header Actions (Search, Wishlist, Cart) -->
    <div class="tornado-header__actions">
      <button class="tornado-header__action-btn" data-search-toggle aria-label="Recherche">
        {% render 'icon-search' %}
      </button>

      <a href="/pages/wishlist" class="tornado-header__action-btn" aria-label="Favoris">
        {% render 'icon-heart' %}
        <span class="tornado-header__badge-count" data-wishlist-count>0</span>
      </a>

      <button class="tornado-header__action-btn tornado-header__cart-btn" data-cart-drawer-toggle aria-label="Panier">
        {% render 'icon-bag' %}
        <span class="tornado-header__cart-count" data-cart-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-overlay" data-mobile-menu-overlay></div>
<aside class="mobile-nav-drawer" data-mobile-menu-drawer aria-hidden="true">
  <div class="mobile-nav-drawer__header">
    <div class="tornado-header__logo-link">
      <span class="tornado-header__vortex">{% render 'icon-vortex' %}</span>
      <span class="tornado-header__wordmark">TORNADO</span>
    </div>
    <button class="mobile-nav-drawer__close" data-mobile-menu-close aria-label="Fermer le menu">
      {% render 'icon-close' %}
    </button>
  </div>

  <div class="mobile-nav-drawer__body">
    <ul class="mobile-nav__list">
      <li class="mobile-nav__item">
        <a href="/collections/all" class="mobile-nav__link">SHOP</a>
      </li>
      <li class="mobile-nav__item">
        <a href="/collections/sweats" class="mobile-nav__sublink">&mdash; Sweats & Hoodies</a>
        <a href="/collections/vestes" class="mobile-nav__sublink">&mdash; Vestes</a>
        <a href="/collections/sneakers" class="mobile-nav__sublink">&mdash; Sneakers</a>
        <a href="/collections/sacs" class="mobile-nav__sublink">&mdash; Sacs & Bijoux</a>
      </li>
      <li class="mobile-nav__item">
        <a href="/collections/new-drops" class="mobile-nav__link text-gold-gradient">DISCOVER DROPS</a>
      </li>
      <li class="mobile-nav__item">
        <a href="/pages/marques" class="mobile-nav__link">MARQUES</a>
      </li>
    </ul>
  </div>
</aside>

<!-- Predictive Search Modal / Overlay -->
<div class="search-modal-overlay" data-search-overlay></div>
<div class="search-modal" data-search-modal aria-hidden="true">
  <div class="container search-modal__inner">
    <div class="search-modal__header">
      <form action="{{ routes.search_url }}" method="get" class="search-modal__form">
        <span class="search-modal__icon">{% render 'icon-search' %}</span>
        <input type="search" name="q" placeholder="Rechercher un produit, hoodie, sneaker..." class="search-modal__input" data-predictive-search-input autocomplete="off">
        <button type="button" class="search-modal__close" data-search-close aria-label="Fermer">
          {% render 'icon-close' %}
        </button>
      </form>
    </div>
    <div class="search-modal__results" data-predictive-search-results>
      <p class="text-secondary text-sm">Saisissez un mot-clé pour commencer la recherche...</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header & Navigation",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Afficher la barre d'annonce",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texte d'annonce",
      "default": "LIVRAISON GRATUITE EN FRANCE DÈS 150 € — ACCÈS ANTICIPÉ DROPS"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Activer le Header Sticky au Scroll",
      "default": true
    }
  ]
}
{% endschema %}
