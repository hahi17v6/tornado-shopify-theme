<section class="tornado-section container">
  <h2 class="tornado-section__title display-subtitle mb-lg">UNIVERS & CATÉGORIES</h2>
  <div class="bento-grid">
    <div class="bento-card bento-card--large">
      <div class="bento-card__bg bento-placeholder-1"></div>
      <div class="bento-card__content">
        <span class="badge-tornado badge-drop">MUST HAVE</span>
        <h3>SWEATS & HOODIES</h3>
        <a href="/collections/sweats" class="btn-tornado-secondary">DÉCOUVRIR</a>
      </div>
    </div>

    <div class="bento-card">
      <div class="bento-card__bg bento-placeholder-2"></div>
      <div class="bento-card__content">
        <h3>SNEAKERS</h3>
        <a href="/collections/sneakers" class="btn-tornado-secondary">VOIR</a>
      </div>
    </div>

    <div class="bento-card">
      <div class="bento-card__bg bento-placeholder-3"></div>
      <div class="bento-card__content">
        <h3>SACS & BIJOUX</h3>
        <a href="/collections/accessoires" class="btn-tornado-secondary">EXPLORER</a>
      </div>
    </div>
  </div>
</section>

