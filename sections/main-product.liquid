{%- comment -%}
  TORNADO — FICHE PRODUIT PREMIUM (PHASE 5)
  Section principale OS 2.0 avec galerie, variantes, AJAX cart,
  accordéons, trust badges et recommandations.
{%- endcomment -%}

<div class="tornado-pdp" data-product-page data-product-handle="{{ product.handle }}">
  <div class="container">
    {%- comment -%} Fil d'Ariane {%- endcomment -%}
    <nav class="pdp-breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span class="pdp-breadcrumb__sep">/</span>
      {%- if product.collections.first -%}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span class="pdp-breadcrumb__sep">/</span>
      {%- endif -%}
      <span class="pdp-breadcrumb__current">{{ product.title }}</span>
    </nav>

    {%- comment -%} Layout principal : Galerie + Détails {%- endcomment -%}
    <div class="tornado-pdp__grid">

      {%- comment -%} COLONNE GAUCHE — GALERIE {%- endcomment -%}
      <div class="tornado-pdp__gallery-col">
        {% render 'product-gallery', product: product %}
      </div>

      {%- comment -%} COLONNE DROITE — DÉTAILS PRODUIT {%- endcomment -%}
      <div class="tornado-pdp__details" data-product-details>

        {%- comment -%} Vendor / Marque {%- endcomment -%}
        <span class="tornado-pdp__vendor">{{ product.vendor | default: 'TORNADO' }}</span>

        {%- comment -%} Titre Produit {%- endcomment -%}
        <h1 class="tornado-pdp__title display-subtitle">{{ product.title }}</h1>

        {%- comment -%} Prix {%- endcomment -%}
        <div class="tornado-pdp__price" data-product-price>
          {%- assign current_variant = product.selected_or_first_available_variant -%}
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="price price--sale" data-sale-price>{{ current_variant.price | money }}</span>
            <span class="price price--compare" data-compare-price>{{ current_variant.compare_at_price | money }}</span>
            {%- assign savings = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
            <span class="price price--savings">-{{ savings }}%</span>
          {%- else -%}
            <span class="price price--regular" data-regular-price>{{ current_variant.price | money }}</span>
          {%- endif -%}
        </div>

        {%- comment -%} Fit Type Metafield {%- endcomment -%}
        {%- if product.metafields.custom.fit_type != blank -%}
          <div class="tornado-pdp__fit-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.38 3.46L16 2 12 5.69 8 2 3.62 3.46 2 8l3.69 4L2 16l1.62 4.54L8 22l4-3.69L16 22l4.38-1.46L22 16l-3.69-4L22 8l-1.62-4.54z"/></svg>
            <span>{{ product.metafields.custom.fit_type }}</span>
          </div>
        {%- endif -%}

        {%- comment -%} Formulaire d'ajout au panier {%- endcomment -%}
        {%- form 'product', product, id: 'pdp-add-form', data-product-form: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

          {%- comment -%} Sélecteurs d'options (Taille, Couleur, etc.) {%- endcomment -%}
          {%- for option in product.options_with_values -%}
            <div class="tornado-pdp__option-group" data-option-group="{{ option.name | handleize }}">
              <label class="tornado-pdp__option-label">
                {{ option.name }}
                {%- if option.name == 'Taille' or option.name == 'Size' -%}
                  <button type="button" class="pdp-size-guide-link" data-size-guide-toggle aria-label="Guide des tailles">
                    Guide des tailles
                  </button>
                {%- endif -%}
              </label>

              {%- if option.name == 'Couleur' or option.name == 'Color' or option.name == 'Colour' -%}
                {%- comment -%} Swatches de couleurs visuelles {%- endcomment -%}
                <div class="tornado-pdp__color-swatches">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="pdp-color-swatch {% if option.selected_value == value %}is-active{% endif %}"
                      data-option-name="{{ option.name }}"
                      data-option-value="{{ value }}"
                      title="{{ value }}"
                      aria-label="{{ option.name }}: {{ value }}"
                      style="--swatch-color: {{ value | handleize }}"
                    >
                      <span class="pdp-color-swatch__inner"></span>
                    </button>
                  {%- endfor -%}
                </div>
                <span class="tornado-pdp__option-selected" data-selected-option="{{ option.name }}">{{ option.selected_value }}</span>

              {%- else -%}
                {%- comment -%} Chips de taille ou option générique {%- endcomment -%}
                <div class="tornado-pdp__size-selector">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="btn-size-option {% if option.selected_value == value %}selected{% endif %}"
                      data-option-name="{{ option.name }}"
                      data-option-value="{{ value }}"
                      aria-label="{{ option.name }}: {{ value }}"
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}

          {%- comment -%} Quantité + Bouton Ajouter {%- endcomment -%}
          <div class="tornado-pdp__actions">
            <div class="tornado-pdp__qty-wrap">
              <button type="button" class="tornado-pdp__qty-btn" data-qty-minus aria-label="Réduire la quantité">−</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                max="{{ current_variant.inventory_quantity | default: 99 }}"
                class="tornado-pdp__qty-input"
                data-qty-input
                aria-label="Quantité"
              >
              <button type="button" class="tornado-pdp__qty-btn" data-qty-plus aria-label="Augmenter la quantité">+</button>
            </div>

            <button
              type="submit"
              class="btn-tornado-primary tornado-pdp__add-btn"
              data-add-to-cart-btn
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                <span data-add-text>AJOUTER AU PANIER</span>
                <span class="pdp-add-btn__price" data-add-price>— {{ current_variant.price | money }}</span>
              {%- else -%}
                <span data-add-text>ÉPUISÉ</span>
              {%- endif -%}
            </button>
          </div>

          {%- comment -%} Wishlist {%- endcomment -%}
          <button type="button" class="tornado-pdp__wishlist-btn" data-wishlist-add="{{ product.id }}" aria-label="Ajouter aux favoris">
            {% render 'icon-heart' %}
            <span>Ajouter aux favoris</span>
          </button>
        {%- endform -%}

        {%- comment -%} Trust Badges {%- endcomment -%}
        {%- if section.settings.show_trust_badges -%}
          {% render 'product-trust-badges' %}
        {%- endif -%}

        {%- comment -%} Accordéons informatifs {%- endcomment -%}
        <div class="tornado-pdp__accordions">
          {%- comment -%} Description {%- endcomment -%}
          {%- if product.description != blank -%}
            <details class="tornado-accordion" open>
              <summary class="tornado-accordion__summary">
                DESCRIPTION
                <span class="tornado-accordion__chevron">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <div class="tornado-accordion__content">
                {{ product.description }}
              </div>
            </details>
          {%- endif -%}

          {%- comment -%} Guide des tailles {%- endcomment -%}
          {%- if section.settings.size_guide_content != blank -%}
            <details class="tornado-accordion" data-size-guide-accordion>
              <summary class="tornado-accordion__summary">
                GUIDE DES TAILLES
                <span class="tornado-accordion__chevron">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <div class="tornado-accordion__content">
                {{ section.settings.size_guide_content }}
              </div>
            </details>
          {%- endif -%}

          {%- comment -%} Composition & Entretien {%- endcomment -%}
          <details class="tornado-accordion">
            <summary class="tornado-accordion__summary">
              COMPOSITION & ENTRETIEN
              <span class="tornado-accordion__chevron">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="tornado-accordion__content">
              {%- if product.metafields.custom.material_composition != blank -%}
                <p><strong>Composition :</strong> {{ product.metafields.custom.material_composition }}</p>
              {%- endif -%}
              {%- if product.metafields.custom.care_instructions != blank -%}
                <p><strong>Entretien :</strong> {{ product.metafields.custom.care_instructions }}</p>
              {%- else -%}
                <p>Lavage en machine à 30°C. Ne pas utiliser de sèche-linge. Repassage à basse température.</p>
              {%- endif -%}
            </div>
          </details>

          {%- comment -%} Livraison & Retours {%- endcomment -%}
          <details class="tornado-accordion">
            <summary class="tornado-accordion__summary">
              LIVRAISON & RETOURS
              <span class="tornado-accordion__chevron">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="tornado-accordion__content">
              <p><strong>Livraison standard :</strong> 3-5 jours ouvrés (4,90 € / Gratuite dès 150 €)</p>
              <p><strong>Livraison express :</strong> 24-48h (9,90 €)</p>
              <p><strong>Retours :</strong> Gratuits sous 14 jours dans leur emballage d'origine.</p>
            </div>
          </details>
        </div>

      </div>
    </div>

    {%- comment -%} Recommandations produit {%- endcomment -%}
    {% render 'product-recommendations', product: product %}

    {%- comment -%} Avis clients & Réputation {%- endcomment -%}
    {% render 'product-reviews', product: product %}

  </div>
</div>

{%- comment -%} Données JSON pour le JavaScript de sélection des variantes {%- endcomment -%}
<script type="application/json" data-product-json>
  {
    "id": {{ product.id }},
    "title": {{ product.title | json }},
    "handle": {{ product.handle | json }},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 'null' }},
          "available": {{ variant.available }},
          "options": {{ variant.options | json }},
          "featured_media_id": {{ variant.featured_media.id | default: 'null' }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "options": {{ product.options | json }},
    "url": {{ product.url | json }}
  }
</script>

{%- comment -%} Données structurées JSON-LD (Product) {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncatewords: 100 | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  {%- if product.featured_media -%}
  "image": "{{ product.featured_media | image_url: width: 1200 }}",
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "lowPrice": {{ product.price_min | money_without_currency | json }},
    "highPrice": {{ product.price_max | money_without_currency | json }},
    "offerCount": {{ product.variants.size }},
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
  }
}
</script>

{% schema %}
{
  "name": "Fiche Produit TORNADO",
  "tag": "section",
  "class": "pdp-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Afficher les badges de confiance",
      "default": true
    },
    {
      "type": "richtext",
      "id": "size_guide_content",
      "label": "Guide des tailles (HTML/Texte)",
      "default": "<p><strong>XS</strong> : Tour de poitrine 84-88 cm<br><strong>S</strong> : 88-92 cm<br><strong>M</strong> : 92-96 cm<br><strong>L</strong> : 96-100 cm<br><strong>XL</strong> : 100-104 cm<br><strong>XXL</strong> : 104-108 cm</p>"
    },
    {
      "type": "text",
      "id": "trust_1_title",
      "label": "Trust 1 — Titre",
      "default": "Livraison Express"
    },
    {
      "type": "text",
      "id": "trust_1_desc",
      "label": "Trust 1 — Description",
      "default": "48h en France"
    },
    {
      "type": "text",
      "id": "trust_2_title",
      "label": "Trust 2 — Titre",
      "default": "Retour 14 Jours"
    },
    {
      "type": "text",
      "id": "trust_2_desc",
      "label": "Trust 2 — Description",
      "default": "Satisfait ou remboursé"
    },
    {
      "type": "text",
      "id": "trust_3_title",
      "label": "Trust 3 — Titre",
      "default": "Paiement Sécurisé"
    },
    {
      "type": "text",
      "id": "trust_3_desc",
      "label": "Trust 3 — Description",
      "default": "SSL 256-bit crypté"
    },
    {
      "type": "text",
      "id": "trust_4_title",
      "label": "Trust 4 — Titre",
      "default": "Authenticité Garantie"
    },
    {
      "type": "text",
      "id": "trust_4_desc",
      "label": "Trust 4 — Description",
      "default": "100% produits originaux"
    },
    {
      "type": "text",
      "id": "reco_heading",
      "label": "Titre section recommandations",
      "default": "VOUS AIMEREZ AUSSI"
    }
  ]
}
{% endschema %}
