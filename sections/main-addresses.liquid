{%- comment -%}
  TORNADO — CUSTOMER ADDRESSES (PHASE 7)
  Section de gestion des adresses client OS 2.0
{%- endcomment -%}

<div class="tornado-customer-addresses container padding-v-2xl">
  <div class="margin-bottom-lg">
    <a href="{{ routes.account_url }}" class="text-xs text-gold hover-gold font-bold uppercase inline-flex items-center gap-xs margin-bottom-md">
      &larr; RETOUR À MON COMPTE
    </a>
    <h1 class="font-heading text-2xl uppercase tracking-widest text-white margin-bottom-xs">
      MES ADRESSES DE LIVRAISON
    </h1>
    <p class="text-xs text-secondary">Gérez vos adresses préenregistrées pour vos commandes ultérieures.</p>
  </div>

  <div class="grid grid-2-col gap-xl">
    <!-- Existing Addresses List -->
    <div class="addresses-list flex flex-column gap-md">
      {%- for address in customer.addresses -%}
        <div class="address-card tornado-glass-card padding-lg relative">
          {%- if address == customer.default_address -%}
            <span class="tornado-badge tornado-badge--gold absolute top-4 right-4 text-xs">PAR DÉFAUT</span>
          {%- endif -%}
          <h3 class="font-heading text-sm text-white margin-bottom-xs">{{ address.first_name }} {{ address.last_name }}</h3>
          <div class="text-xs text-secondary line-height-relaxed margin-bottom-md">
            <p class="margin-none">{{ address.address1 }}</p>
            {% if address.address2 %}<p class="margin-none">{{ address.address2 }}</p>{% endif %}
            <p class="margin-none">{{ address.zip }} {{ address.city }}</p>
            <p class="margin-none">{{ address.country }}</p>
            {% if address.phone %}<p class="margin-none text-gold">{{ address.phone }}</p>{% endif %}
          </div>
          <form class="address-delete-form inline-block" method="post" action="/account/addresses/{{ address.id }}">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="tornado-btn tornado-btn--outline text-xs padding-xs text-danger" onclick="return confirm('Supprimer cette adresse ?');">
              SUPPRIMER
            </button>
          </form>
        </div>
      {%- endfor -%}
    </div>

    <!-- Add New Address Form -->
    <div class="new-address-col">
      <div class="tornado-glass-card padding-lg">
        <h2 class="font-heading text-md uppercase text-white margin-bottom-md border-bottom padding-bottom-xs">
          AJOUTER UNE NOUVELLE ADRESSE
        </h2>
        {%- form 'customer_address', customer.new_address, class: 'address-form' -%}
          <div class="form-group margin-bottom-sm">
            <input type="text" name="address[first_name]" placeholder="Prénom *" required class="tornado-input w-full">
          </div>
          <div class="form-group margin-bottom-sm">
            <input type="text" name="address[last_name]" placeholder="Nom *" required class="tornado-input w-full">
          </div>
          <div class="form-group margin-bottom-sm">
            <input type="text" name="address[address1]" placeholder="Adresse (Ligne 1) *" required class="tornado-input w-full">
          </div>
          <div class="form-group margin-bottom-sm">
            <input type="text" name="address[address2]" placeholder="Complément d'adresse" class="tornado-input w-full">
          </div>
          <div class="form-group margin-bottom-sm">
            <input type="text" name="address[city]" placeholder="Ville *" required class="tornado-input w-full">
          </div>
          <div class="form-group margin-bottom-sm">
            <input type="text" name="address[zip]" placeholder="Code Postal *" required class="tornado-input w-full">
          </div>
          <div class="form-group margin-bottom-sm">
            <input type="text" name="address[country]" placeholder="Pays *" required class="tornado-input w-full" value="France">
          </div>
          <div class="form-group margin-bottom-md">
            <input type="tel" name="address[phone]" placeholder="Téléphone" class="tornado-input w-full">
          </div>
          <div class="form-group margin-bottom-md flex items-center gap-xs">
            {{ form.set_as_default_checkbox }}
            <label for="address_default_address_new" class="text-xs text-secondary cursor-pointer">Définir comme adresse par défaut</label>
          </div>
          <button type="submit" class="tornado-btn tornado-btn--gold text-xs font-bold uppercase w-full padding-v-md">
            ENREGISTRER L'ADRESSE
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Adresses Client",
  "settings": []
}
{% endschema %}
