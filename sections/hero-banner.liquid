<section class="tornado-hero" data-section-id="{{ section.id }}">
  <div class="tornado-hero__bg">
    {% if section.settings.video_url != blank %}
      <video class="tornado-hero__video" autoplay muted loop playsinline poster="{{ section.settings.image | image_url: width: 1920 }}">
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {% elsif section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1920 }}" alt="{{ section.settings.heading | escape }}" loading="eager" width="1920" height="1080" class="tornado-hero__img">
    {% else %}
      <div class="tornado-hero__placeholder"></div>
    {% endif %}
    <div class="tornado-hero__overlay"></div>
  </div>

  <div class="tornado-hero__content container">
    <div class="tornado-hero__badge-wrap mb-sm">
      <span class="badge-tornado badge-drop">{{ section.settings.badge_text }}</span>
    </div>
    
    <h1 class="tornado-hero__heading display-title text-glow-subtle">{{ section.settings.heading }}</h1>
    <p class="tornado-hero__subheading text-secondary max-w-600 mb-xl">{{ section.settings.subheading }}</p>
    
    <div class="tornado-hero__actions">
      <a href="{{ section.settings.primary_button_link }}" class="btn-tornado-primary">
        {{ section.settings.primary_button_label }}
      </a>
      {% if section.settings.secondary_button_label != blank %}
        <a href="{{ section.settings.secondary_button_link }}" class="btn-tornado-secondary ml-md">
          {{ section.settings.secondary_button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière Hero Immersive",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texte Badge",
      "default": "NOUVEAU DROP 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre Principal",
      "default": "THE STORM OF LUXURY STREETWEAR"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Haute couture urbaine et pièces d'exception. Éditions numérotées en tirage limité."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de fond / Poster Vidéo"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "URL Vidéo MP4 (Optionnel)"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Libellé Bouton Principal",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Lien Bouton Principal",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Libellé Bouton Secondaire",
      "default": "DISCOVER THE DROP"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Lien Bouton Secondaire",
      "default": "/collections/new-drops"
    }
  ],
  "presets": [
    {
      "name": "Bannière Hero Immersive TORNADO"
    }
  ]
}
{% endschema %}
