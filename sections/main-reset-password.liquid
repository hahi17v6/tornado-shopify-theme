{%- comment -%}
  TORNADO — RESET PASSWORD (PHASE 7)
  Section de réinitialisation de mot de passe client OS 2.0
{%- endcomment -%}

<div class="tornado-customer-auth container padding-v-2xl">
  <div class="auth-card tornado-glass-card max-w-md margin-auto padding-xl text-center">
    <h1 class="auth-title font-heading text-2xl uppercase tracking-widest text-white margin-bottom-xs">
      NOUVEAU MOT DE PASSE
    </h1>
    <p class="text-xs text-secondary margin-bottom-lg">
      Saisissez votre nouveau mot de passe pour sécuriser votre compte.
    </p>

    {%- form 'reset_customer_password', class: 'auth-form' -%}
      {%- if form.errors -%}
        <div class="auth-error tornado-badge tornado-badge--danger margin-bottom-md w-full text-center">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="form-group margin-bottom-md">
        <label for="ResetPassword" class="visually-hidden">Nouveau mot de passe</label>
        <input type="password" name="customer[password]" id="ResetPassword" placeholder="Nouveau mot de passe *" required class="tornado-input w-full">
      </div>

      <div class="form-group margin-bottom-md">
        <label for="PasswordConfirmation" class="visually-hidden">Confirmer le mot de passe</label>
        <input type="password" name="customer[password_confirmation]" id="PasswordConfirmation" placeholder="Confirmer le mot de passe *" required class="tornado-input w-full">
      </div>

      <button type="submit" class="tornado-btn tornado-btn--gold text-sm font-bold uppercase tracking-wider w-full padding-v-md">
        RÉINITIALISER MON MOT DE PASSE
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Réinitialisation Mot de Passe",
  "settings": []
}
{% endschema %}
