{%- comment -%}
  TORNADO — CART DRAWER PREMIUM (PHASE 6)
  Tiroir de panier AJAX coulissant 100% natif Shopify OS 2.0
  Seuil de livraison gratuite (150 €), modifications AJAX, réductions et checkout.
{%- endcomment -%}

{%- assign free_shipping_threshold_cents = section.settings.free_shipping_threshold | default: 150 | times: 100 -%}
{%- assign cart_total = cart.total_price -%}
{%- if cart_total >= free_shipping_threshold_cents -%}
  {%- assign free_shipping_unlocked = true -%}
  {%- assign remaining_cents = 0 -%}
  {%- assign progress_percent = 100 -%}
{%- else -%}
  {%- assign free_shipping_unlocked = false -%}
  {%- assign remaining_cents = free_shipping_threshold_cents | minus: cart_total -%}
  {%- assign progress_percent = cart_total | times: 100 | divided_by: free_shipping_threshold_cents -%}
{%- endif -%}

<!-- Cart Overlay -->
<div class="tornado-cart-overlay" data-cart-overlay aria-hidden="true"></div>

<!-- Cart Drawer Container -->
<aside class="tornado-cart-drawer" data-cart-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t | default: 'Votre Panier' }}">
  <!-- Header -->
  <div class="cart-drawer__header">
    <div class="cart-drawer__title-wrap">
      <h2 class="cart-drawer__title font-heading text-xl uppercase tracking-wider text-white margin-none">
        VOTRE PANIER
      </h2>
      <span class="cart-drawer__count text-gold text-xs font-bold font-mono" data-cart-count-badge>
        ({{ cart.item_count }} {{ cart.item_count | pluralize: 'ARTICLE', 'ARTICLES' }})
      </span>
    </div>
    <button type="button" class="cart-drawer__close" data-cart-close aria-label="Fermer le panier">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Free Shipping Progress Bar -->
  {%- if section.settings.show_free_shipping_bar -%}
    <div class="cart-drawer__shipping-bar" data-shipping-bar-container>
      <div class="cart-drawer__shipping-text text-xs text-center font-bold" data-shipping-bar-text>
        {%- if free_shipping_unlocked -%}
          <span class="text-gold">✨ LIVRAISON GRATUITE OFFERTE !</span>
        {%- else -%}
          <span>Plus que <strong class="text-gold" data-shipping-remaining>{{ remaining_cents | money }}</strong> pour la <strong>livraison gratuite</strong></span>
        {%- endif -%}
      </div>
      <div class="cart-drawer__progress-track">
        <div class="cart-drawer__progress-fill" data-shipping-bar-fill style="width: {{ progress_percent }}%;"></div>
      </div>
    </div>
  {%- endif -%}

  <!-- Cart Content Body -->
  <div class="cart-drawer__body" data-cart-drawer-body>
    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__items-list" data-cart-items-container>
        {%- for item in cart.items -%}
          <div class="cart-item" data-cart-item-key="{{ item.key }}">
            <!-- Item Image -->
            <a href="{{ item.url }}" class="cart-item__image-link">
              {%- if item.image != blank -%}
                <img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}" loading="lazy" width="90" height="120" class="cart-item__image">
              {%- else -%}
                <div class="cart-item__image-placeholder">TORNADO</div>
              {%- endif -%}
            </a>

            <!-- Item Info -->
            <div class="cart-item__details">
              <div class="cart-item__header-row">
                <a href="{{ item.url }}" class="cart-item__title font-bold text-sm text-white hover-gold">
                  {{ item.product.title }}
                </a>
                <button type="button" class="cart-item__remove-btn text-xs text-secondary hover-gold" data-cart-remove="{{ item.key }}" aria-label="Supprimer {{ item.title | escape }}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                </button>
              </div>

              {%- unless item.product.has_only_default_variant -%}
                <div class="cart-item__variant text-xs text-secondary margin-v-xs">
                  {{ item.variant.title }}
                </div>
              {%- endunless -%}

              <!-- Disallowed / Line level discounts -->
              {%- if item.line_level_discount_allocations.size > 0 -%}
                <div class="cart-item__discounts text-xs text-gold">
                  {%- for discount in item.line_level_discount_allocations -%}
                    <span>🏷️ {{ discount.discount_application.title }} (-{{ discount.amount | money }})</span>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <!-- Quantity & Price Row -->
              <div class="cart-item__footer-row">
                <div class="cart-item__qty-picker" data-qty-container>
                  <button type="button" class="cart-item__qty-btn" data-qty-adjust="minus" data-key="{{ item.key }}" aria-label="Réduire la quantité">-</button>
                  <span class="cart-item__qty-num font-mono text-sm font-bold text-white" data-qty-value>{{ item.quantity }}</span>
                  <button type="button" class="cart-item__qty-btn" data-qty-adjust="plus" data-key="{{ item.key }}" aria-label="Augmenter la quantité">+</button>
                </div>

                <div class="cart-item__price-wrap text-right">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <span class="cart-item__price--compare text-xs text-secondary line-through">{{ item.original_line_price | money }}</span>
                    <span class="cart-item__price text-sm font-bold text-gold-gradient">{{ item.final_line_price | money }}</span>
                  {%- else -%}
                    <span class="cart-item__price text-sm font-bold text-white">{{ item.final_line_price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <!-- In-Cart Recommendations / Cross-sell -->
      {%- if section.settings.show_cross_sell -%}
        <div class="cart-drawer__cross-sell margin-top-lg">
          <h3 class="cross-sell__title font-heading text-xs uppercase tracking-widest text-gold margin-bottom-sm">
            {{ section.settings.cross_sell_title | default: 'COMPLÉTEZ LE LOOK' }}
          </h3>
          <div class="cross-sell__grid">
            {%- assign cross_sell_collection = collections[section.settings.cross_sell_collection] | default: collections.all -%}
            {%- for product in cross_sell_collection.products limit: 2 -%}
              <div class="cross-sell__item">
                <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="50" height="65" class="cross-sell__img">
                <div class="cross-sell__info">
                  <div class="cross-sell__name text-xs font-bold text-white truncate">{{ product.title }}</div>
                  <div class="cross-sell__price text-xs text-gold-gradient font-bold">{{ product.price | money }}</div>
                </div>
                <button type="button" class="cross-sell__add-btn tornado-btn tornado-btn--outline text-xs" data-quick-add="{{ product.selected_or_first_available_variant.id }}">
                  + AJOUTER
                </button>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

    {%- else -%}
      <!-- Empty Cart State -->
      <div class="cart-drawer__empty" data-cart-empty-state>
        <div class="cart-empty__icon margin-bottom-md">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </div>
        <h3 class="cart-empty__title font-heading text-lg uppercase tracking-wider text-white margin-bottom-xs">
          VOTRE PANIER EST VIDE
        </h3>
        <p class="cart-empty__subtitle text-xs text-secondary margin-bottom-lg">
          Découvrez la collection exclusive TORNADO et ajoutez vos pièces d'exception.
        </p>
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="tornado-btn tornado-btn--primary text-sm font-bold uppercase tracking-wider" data-cart-close>
          CONTINUER MES ACHATS
        </a>
      </div>
    {%- endif -%}
  </div>

  <!-- Cart Footer (Only visible when items > 0) -->
  {%- if cart.item_count > 0 -%}
    <div class="cart-drawer__footer" data-cart-footer>
      <!-- Subtotal Row -->
      <div class="cart-footer__row cart-footer__row--subtotal">
        <span class="text-sm font-bold uppercase tracking-wider text-secondary">SOUS-TOTAL</span>
        <span class="text-lg font-bold font-heading text-white" data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>

      <!-- Discounts Info -->
      {%- if cart.cart_level_discount_applications.size > 0 -%}
        <div class="cart-footer__row cart-footer__row--discounts text-gold text-xs font-bold">
          <span>RÉDUCTIONS APPLIQUÉES</span>
          <div>
            {%- for discount in cart.cart_level_discount_applications -%}
              <div>{{ discount.title }}: -{{ discount.total_allocated_amount | money }}</div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <p class="cart-footer__note text-xs text-secondary margin-v-xs text-center">
        Taxes et frais d'expédition calculés lors du paiement.
      </p>

      <!-- Cart Action Buttons -->
      <div class="cart-footer__actions">
        <a href="{{ routes.cart_url }}" class="tornado-btn tornado-btn--outline text-xs uppercase font-bold text-center">
          VOIR LE PANIER
        </a>
        
        <form action="{{ routes.cart_url }}" method="post" class="cart-footer__checkout-form">
          <button type="submit" name="checkout" class="tornado-btn tornado-btn--gold text-sm font-bold uppercase tracking-wider w-full">
            CHECKOUT &bull; <span data-cart-total-checkout>{{ cart.total_price | money }}</span>
          </button>
        </form>
      </div>

      <!-- Security / Trust Note -->
      <div class="cart-footer__trust text-xs text-secondary text-center margin-top-xs">
        🔒 Paiement SSL 100% Sécurisé &bull; Expédition 24/48H
      </div>
    </div>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "Cart Drawer TORNADO",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_free_shipping_bar",
      "label": "Afficher la barre de livraison gratuite",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Seuil de livraison gratuite (€)",
      "default": 150
    },
    {
      "type": "checkbox",
      "id": "show_cross_sell",
      "label": "Afficher la section Recommandations / Cross-sell",
      "default": true
    },
    {
      "type": "text",
      "id": "cross_sell_title",
      "label": "Titre du Cross-sell",
      "default": "COMPLÉTEZ LE LOOK"
    },
    {
      "type": "collection",
      "id": "cross_sell_collection",
      "label": "Collection de recommandation"
    }
  ]
}
{% endschema %}
