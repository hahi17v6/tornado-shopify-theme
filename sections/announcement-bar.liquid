{%- comment -%}
  TORNADO — ANNOUNCEMENT BAR SECTION (PHASE 8)
  Barre supérieure de communication marketing (Livraison 150€ / Offre -10% / Drop)
{%- endcomment -%}

{%- if section.settings.show_announcement -%}
  <div class="tornado-announcement-bar bg-surface text-center padding-v-xs border-bottom border-subtle relative z-50">
    <div class="container flex justify-between items-center text-xs font-bold font-mono">
      <div class="announcement-spacer w-12 hidden-mobile"></div>
      
      <div class="announcement-content text-gold-gradient tracking-wider flex-1 text-center">
        <span>✨ {{ section.settings.text | default: "LIVRAISON OFFERTE DÈS 150 € EN FRANCE & EUROPE &bull; CODE 'STORM10' POUR -10%" }}</span>
      </div>

      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="text-white hover-gold text-xs underline font-sans hidden-mobile">
          VOIR &rarr;
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'Annonce Top",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Afficher la barre d'annonce",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texte d'annonce",
      "default": "LIVRAISON OFFERTE DÈS 150 € EN FRANCE & EUROPE • CODE 'STORM10' POUR -10%"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien optionnel"
    }
  ]
}
{% endschema %}
