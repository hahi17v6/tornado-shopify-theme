{%- comment -%}
  TORNADO — 404 PAGE SECTION (PHASE 12)
  Page 404 d'erreur de navigation avec esthétique luxe et retour au catalogue
{%- endcomment -%}

<div class="tornado-404-section container padding-v-2xl text-center">
  <div class="tornado-glass-card padding-2xl max-w-lg margin-auto">
    <span class="tornado-badge tornado-badge--gold margin-bottom-xs">ERREUR 404</span>
    <h1 class="font-heading text-4xl uppercase tracking-widest text-gold-gradient margin-bottom-xs">
      LOST IN THE STORM?
    </h1>
    <p class="text-xs text-secondary margin-bottom-xl line-height-relaxed">
      La page que vous recherchez n'existe pas ou a été déplacée. Explorez notre catalogue exclusif pour retrouver vos pièces streetwear préférées.
    </p>

    <div class="flex justify-center gap-md flex-mobile-column">
      <a href="{{ routes.root_url }}" class="tornado-btn tornado-btn--gold text-xs font-bold uppercase tracking-wider">
        ACCUEIL &rarr;
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="tornado-btn tornado-btn--outline text-xs font-bold uppercase tracking-wider">
        VOIR LE CATALOGUE
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page 404 TORNADO",
  "settings": []
}
{% endschema %}
