<section class="tornado-section container" data-section-id="{{ section.id }}">
  <div class="tornado-search-header text-center mb-xl">
    <span class="badge-tornado badge-drop mb-xs">MOTEUR DE RECHERCHE</span>
    <h1 class="display-title mb-md">RECHERCHER DANS LE CATALOGUE</h1>

    <form action="{{ routes.search_url }}" method="get" class="search-page-form max-w-600 mx-auto">
      <div class="search-page-input-wrap">
        {% render 'icon-search' %}
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Nike, hoodie, jacket, sneakers..." class="search-page-input" autocomplete="off">
        <button type="submit" class="btn-tornado-primary">RECHERCHER</button>
      </div>
    </form>
  </div>

  {% if search.performed %}
    <div class="tornado-search-results-info mb-lg">
      <h2 class="display-subtitle text-gold-gradient">
        {{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}
      </h2>
    </div>

    {% if search.results_count > 0 %}
      <div class="tornado-grid tornado-grid--4col">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', card_product: item %}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="glass-panel text-center py-3xl px-lg rounded-md">
        <span class="badge-tornado badge-limited mb-sm">AUCUN RÉSULTAT</span>
        <h3 class="display-subtitle mb-sm">AUCUN PRODUIT TROUVÉ POUR "{{ search.terms }}"</h3>
        <p class="text-secondary max-w-600 mb-lg">Vérifiez l'orthographe ou essayez d'autres mots-clés (ex: Sweats, Sneakers, Veste).</p>
        <a href="/collections/all" class="btn-tornado-primary">VOIR TOUT LE CATALOGUE</a>
      </div>
    {% endif %}
  {% else %}
    <!-- Recommandations par défaut -->
    <div class="tornado-search-suggestions text-center py-xl">
      <h3 class="text-secondary text-sm font-semibold mb-md">RECHERCHES POPULAIRES :</h3>
      <div class="flex-wrap justify-center gap-sm">
        <a href="/search?q=Hoodie" class="btn-tornado-secondary">HOODIES</a>
        <a href="/search?q=Vestes" class="btn-tornado-secondary">VESTES</a>
        <a href="/search?q=Sneakers" class="btn-tornado-secondary">SNEAKERS</a>
        <a href="/search?q=Sacs" class="btn-tornado-secondary">SACS</a>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Page Recherche Native",
  "settings": []
}
{% endschema %}
