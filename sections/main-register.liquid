{%- comment -%}
  TORNADO — REGISTER PAGE (PHASE 7)
  Section d'inscription client native Shopify OS 2.0
{%- endcomment -%}

<div class="tornado-customer-auth container padding-v-2xl">
  <div class="auth-card tornado-glass-card max-w-md margin-auto padding-xl text-center">
    <h1 class="auth-title font-heading text-2xl uppercase tracking-widest text-white margin-bottom-xs">
      CRÉER UN COMPTE
    </h1>
    <p class="text-xs text-secondary margin-bottom-lg">
      Rejoignez le cercle privé TORNADO pour suivre vos commandes et sauvegarder vos pièces exclusives.
    </p>

    {%- form 'create_customer', class: 'auth-form' -%}
      {%- if form.errors -%}
        <div class="auth-error tornado-badge tornado-badge--danger margin-bottom-md w-full text-center">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="form-group margin-bottom-md">
        <label for="FirstName" class="visually-hidden">Prénom</label>
        <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name" placeholder="Prénom *" required class="tornado-input w-full">
      </div>

      <div class="form-group margin-bottom-md">
        <label for="LastName" class="visually-hidden">Nom</label>
        <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name" placeholder="Nom *" required class="tornado-input w-full">
      </div>

      <div class="form-group margin-bottom-md">
        <label for="RegisterEmail" class="visually-hidden">Adresse Email</label>
        <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" placeholder="Adresse Email *" required class="tornado-input w-full">
      </div>

      <div class="form-group margin-bottom-md">
        <label for="RegisterPassword" class="visually-hidden">Mot de passe</label>
        <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" placeholder="Mot de passe *" required class="tornado-input w-full">
      </div>

      <div class="form-group text-left margin-bottom-lg flex items-center gap-xs">
        <input type="checkbox" name="customer[accepts_marketing]" id="AcceptsMarketing" value="true" class="tornado-checkbox">
        <label for="AcceptsMarketing" class="text-xs text-secondary cursor-pointer">
          Je souhaite recevoir les invitations Drops et actualités TORNADO.
        </label>
      </div>

      <button type="submit" class="tornado-btn tornado-btn--gold text-sm font-bold uppercase tracking-wider w-full padding-v-md margin-bottom-md">
        CRÉER MON COMPTE
      </button>

      <div class="auth-switch text-xs text-secondary">
        Déjà inscrit ?
        <a href="{{ routes.account_login_url }}" class="text-gold font-bold uppercase hover-gold">
          SE CONNECTER
        </a>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Inscription Client",
  "settings": []
}
{% endschema %}
