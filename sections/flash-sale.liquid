{%- comment -%}
  TORNADO — FLASH SALE SECTION (PHASE 8)
  Vente flash avec compte à rebours temporel réel basé sur une date de fin configurable.
{%- endcomment -%}

{%- assign end_date = section.settings.end_date | default: '2026-12-31T23:59:59' -%}

<section class="tornado-section flash-sale-section container padding-v-xl" id="flash-sale">
  <div class="tornado-glass-card flash-sale-wrapper padding-2xl relative overflow-hidden border-gold">
    <div class="flex items-center justify-between flex-mobile-column gap-xl">
      <!-- Info Left -->
      <div class="flash-sale-info flex-1">
        <div class="flex items-center gap-xs margin-bottom-xs">
          <span class="tornado-badge tornado-badge--gold">⚡ OFFRE PRIVÉE LIMITÉE</span>
          <span class="tornado-badge tornado-badge--danger">EXPIRATION IMMINENTE</span>
        </div>
        <h2 class="font-heading text-3xl uppercase tracking-widest text-gold-gradient margin-bottom-xs">
          {{ section.settings.title | default: "FLASH SALE ARCHIVES — JUSQU'À -40%" }}
        </h2>
        <p class="text-xs text-secondary margin-bottom-lg max-w-md">
          {{ section.settings.description | default: "Offre à durée limitée réservée au cercle TORNADO sur les pièces sélectionnées. Prix remis automatiquement." }}
        </p>
        <a href="{{ section.settings.link | default: '/collections/all' }}" class="tornado-btn tornado-btn--gold text-xs font-bold uppercase tracking-wider padding-v-md padding-h-xl">
          PROFITER DE LA VENTE FLASH &rarr;
        </a>
      </div>

      <!-- Real Countdown Right -->
      <div class="flash-sale-timer-box text-center padding-lg bg-surface border-radius-md border-gold flex flex-column items-center justify-center min-w-280" data-flash-sale-date="{{ end_date }}">
        <span class="text-xs font-bold text-secondary uppercase tracking-widest margin-bottom-xs">TEMPS RESTANT</span>
        <div class="timer-digits flex gap-sm text-gold font-heading text-3xl font-bold font-mono margin-v-xs">
          <div><span id="flash-hours">00</span><small class="block text-xs text-secondary font-sans font-normal">HEURES</small></div>
          <span>:</span>
          <div><span id="flash-minutes">00</span><small class="block text-xs text-secondary font-sans font-normal">MIN</small></div>
          <span>:</span>
          <div><span id="flash-seconds">00</span><small class="block text-xs text-secondary font-sans font-normal">SEC</small></div>
        </div>
        <span class="text-xs text-gold font-bold margin-top-xs">🔒 PRIX GARANTIS SHOPIFY</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ventes Flash TORNADO",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre Offre",
      "default": "FLASH SALE ARCHIVES — JUSQU'À -40%"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Offre",
      "default": "Offre à durée limitée réservée au cercle TORNADO sur les pièces sélectionnées."
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Date de fin ISO (ex: 2026-12-31T23:59:59)",
      "default": "2026-12-31T23:59:59"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien Collection Vente Flash",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Ventes Flash TORNADO"
    }
  ]
}
{% endschema %}
