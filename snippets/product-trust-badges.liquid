{%- comment -%}
  TORNADO — Trust Badges / Barre de Réassurance Premium
  Icônes SVG inline avec texte configurable
{%- endcomment -%}

<div class="pdp-trust">
  <div class="pdp-trust__item">
    <div class="pdp-trust__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
      </svg>
    </div>
    <div class="pdp-trust__text">
      <span class="pdp-trust__label">{{ section.settings.trust_1_title | default: 'Livraison Express' }}</span>
      <span class="pdp-trust__desc">{{ section.settings.trust_1_desc | default: '48h en France' }}</span>
    </div>
  </div>

  <div class="pdp-trust__item">
    <div class="pdp-trust__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="1 4 1 10 7 10"/>
        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
      </svg>
    </div>
    <div class="pdp-trust__text">
      <span class="pdp-trust__label">{{ section.settings.trust_2_title | default: 'Retour 14 Jours' }}</span>
      <span class="pdp-trust__desc">{{ section.settings.trust_2_desc | default: 'Satisfait ou remboursé' }}</span>
    </div>
  </div>

  <div class="pdp-trust__item">
    <div class="pdp-trust__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <div class="pdp-trust__text">
      <span class="pdp-trust__label">{{ section.settings.trust_3_title | default: 'Paiement Sécurisé' }}</span>
      <span class="pdp-trust__desc">{{ section.settings.trust_3_desc | default: 'SSL 256-bit crypté' }}</span>
    </div>
  </div>

  <div class="pdp-trust__item">
    <div class="pdp-trust__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <polyline points="9 12 11 14 15 10"/>
      </svg>
    </div>
    <div class="pdp-trust__text">
      <span class="pdp-trust__label">{{ section.settings.trust_4_title | default: 'Authenticité Garantie' }}</span>
      <span class="pdp-trust__desc">{{ section.settings.trust_4_desc | default: '100% produits originaux' }}</span>
    </div>
  </div>
</div>
