{%- comment -%}
  TORNADO — Product Gallery Premium
  Galerie produit responsive avec zoom, thumbnails et support vidéo
{%- endcomment -%}

<div class="pdp-gallery" data-product-gallery>
  {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

  {%- comment -%} Image principale zoomable {%- endcomment -%}
  <div class="pdp-gallery__main" data-gallery-main>
    <div class="pdp-gallery__main-wrapper" data-gallery-zoom-wrapper>
      {%- if featured_media -%}
        <img
          src="{{ featured_media | image_url: width: 1200 }}"
          alt="{{ featured_media.alt | escape | default: product.title | escape }}"
          width="1200"
          height="1600"
          loading="eager"
          class="pdp-gallery__main-img"
          data-gallery-main-img
          data-zoom-src="{{ featured_media | image_url: width: 2400 }}"
        >
      {%- else -%}
        <div class="demo-image-placeholder">
          <span>IMAGE PRODUIT</span>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Badges produit {%- endcomment -%}
    <div class="pdp-gallery__badges">
      {%- if product.tags contains 'NEW' or product.tags contains 'Drop' -%}
        <span class="badge-tornado badge-drop">NEW DROP</span>
      {%- endif -%}
      {%- if product.tags contains 'LIMITED' -%}
        <span class="badge-tornado badge-limited">LIMITED</span>
      {%- endif -%}
      {%- if product.compare_at_price > product.price -%}
        {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
        <span class="badge-tornado badge-sale">-{{ savings }}%</span>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Grille de thumbnails {%- endcomment -%}
  {%- if product.media.size > 1 -%}
    <div class="pdp-gallery__thumbs" data-gallery-thumbs>
      {%- for media in product.media -%}
        <button
          type="button"
          class="pdp-gallery__thumb {% if media.id == featured_media.id %}is-active{% endif %}"
          data-gallery-thumb
          data-media-id="{{ media.id }}"
          data-media-src="{{ media | image_url: width: 1200 }}"
          data-zoom-src="{{ media | image_url: width: 2400 }}"
          data-media-alt="{{ media.alt | escape | default: product.title | escape }}"
          aria-label="{{ 'products.product.media' | t }} {{ forloop.index }}"
        >
          {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
            <div class="pdp-gallery__thumb-video-icon">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><polygon points="5,3 13,8 5,13" fill="currentColor"/></svg>
            </div>
          {%- endif -%}
          <img
            src="{{ media | image_url: width: 200 }}"
            alt="{{ media.alt | escape | default: product.title | escape }}"
            width="200"
            height="267"
            loading="lazy"
            class="pdp-gallery__thumb-img"
          >
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
